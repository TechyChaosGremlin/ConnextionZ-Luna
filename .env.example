# Canonical root docker-compose.yml inputs. Copy to .env and replace blanks.
# Generate URL-safe passwords (for example: openssl rand -hex 32), because
# database/broker credentials are embedded in their connection URLs.
ENVIRONMENT=production
DEBUG=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
CORS_ORIGINS=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=connextionz
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
BACKEND_PORT=8000

LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional until an approved beta media provider is configured.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=536870912
