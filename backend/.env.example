# Canonical FastAPI backend; replace every placeholder through deployment secrets.
# Settings reads backend/.env locally. Process environment takes precedence.
ENVIRONMENT=production
DEBUG=false
INFRASTRUCTURE_MODE=full
# Use postgres_beta only after applying migration 218. Redis and RabbitMQ are
# not used in that mode; token revocation is persistent in PostgreSQL.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+asyncpg://beta_user:replace-password@postgres:5432/connextionz_beta
# Optional; otherwise derived from DATABASE_URL. Percent-encode URL credentials.
# DATABASE_URL_SYNC=postgresql+psycopg://beta_migrator:replace-password@postgres:5432/connextionz_beta
REDIS_URL=redis://:replace-password@redis:6379/0
RABBITMQ_URL=amqp://beta_user:replace-password@rabbitmq:5672/
# Pydantic requires JSON for list settings, not comma-separated text.
CORS_ORIGINS=["https://beta.example.com"]
LOG_LEVEL=INFO
LOG_FORMAT=json
# Collaboration marketplace payments stay disabled; the fake adapter is in-memory only.
COLLABORATION_PAYMENT_PROVIDER=disabled
COLLABORATION_PAYMENT_REAL_MONEY_ENABLED=false
# Required for the explicitly configured S3/S3-compatible beta storage provider.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional only when an approved S3-compatible endpoint is used.
AWS_ENDPOINT_URL=
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=536870912
# Existing streaming requires FFmpeg and approved per-platform RTMP destinations.
FFMPEG_PATH=ffmpeg
# STREAMING_TWITCH_DESTINATION_URL=rtmps://replace-approved-destination
# STREAMING_YOUTUBE_DESTINATION_URL=rtmps://replace-approved-destination
# STREAMING_KICK_DESTINATION_URL=rtmps://replace-approved-destination
# STREAMING_FACEBOOK_DESTINATION_URL=rtmps://replace-approved-destination
